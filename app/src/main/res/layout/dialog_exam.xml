<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <Spinner android:id="@+id/spSubject" android:layout_width="match_parent" android:layout_height="48dp" />
    <EditText android:id="@+id/etTitle" style="@style/Field" android:hint="Exam name (e.g. Unit Test 1)" android:inputType="textCapWords" />
    <Button android:id="@+id/btnDate" style="@style/Btn.Sand" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" />
</LinearLayout>
