<resources>
    <style name="Theme.CampusSurvival" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/orange</item>
        <item name="android:colorPrimaryDark">@color/cream</item>
        <item name="android:colorAccent">@color/orange_deep</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:textColorPrimary">@color/brown</item>
        <item name="android:textColorSecondary">@color/brown_light</item>
        <item name="android:alertDialogTheme">@style/Dialog.CampusSurvival</item>
        <item name="android:datePickerDialogTheme">@style/Dialog.CampusSurvival</item>
        <item name="android:timePickerDialogTheme">@style/Dialog.CampusSurvival</item>
    </style>

    <style name="Dialog.CampusSurvival" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/orange_deep</item>
        <item name="android:colorPrimary">@color/orange</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">46dp</item>
    </style>

    <style name="Btn.Sand">
        <item name="android:background">@drawable/bg_btn_sand</item>
        <item name="android:textColor">@color/brown</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brown</item>
    </style>

    <style name="CardText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <style name="Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brown</item>
    </style>

    <!-- White text fields for the orange glass login screen -->
    <style name="Field.Light">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">#CCFFFFFF</item>
        <item name="android:backgroundTint">@color/white</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:textColorHint">@color/brown_light</item>
        <item name="android:backgroundTint">@color/orange</item>
    </style>
</resources>
