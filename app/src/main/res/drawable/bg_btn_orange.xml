<?xml version="1.0" encoding="utf-8"?>
<!-- Orange glass button: translucent gradient + white rim (still strong enough for white text) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D9F4A261" android:endColor="#EBE9762B" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</ripple>
